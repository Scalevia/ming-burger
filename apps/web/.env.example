# Copy to `.env.local` for local development. Never commit real values.
# Only PUBLIC values belong here: everything prefixed VITE_ is bundled into the browser.
# NEVER put the Supabase secret / service_role key in any VITE_ variable.

# development | preview | production
VITE_APP_ENV=development

# Public site origin used for canonical / hreflang URLs (no trailing slash).
VITE_SITE_URL=http://localhost:5173

# Supabase project URL and PUBLISHABLE key (local: from `pnpm db:start` output).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
